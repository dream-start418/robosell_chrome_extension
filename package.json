{
  "name": "robosell",
  "displayName": "Robosell",
  "version": "11.6.5",
  "description": "For supporting doctrack App Server",
  "author": "hayashi",
  "scripts": {
    "dev": "PARCEL_WORKER_BACKEND=process plasmo dev",
    "build": "PARCEL_WORKER_BACKEND=process plasmo build",
    "package": "PARCEL_WORKER_BACKEND=process plasmo package"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "sharp": "^0.34.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@parcel/watcher": "^2.5.6",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "^10.4.21",
    "plasmo": "0.90.5",
    "postcss": "^8.5.3",
    "prettier": "3.2.4",
    "tailwindcss": "^3.4.17",
    "typescript": "5.3.3"
  },
  "manifest": {
    "host_permissions": [
      "https://*/*"
    ],
    "permissions": [
